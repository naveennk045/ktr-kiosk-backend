# Copy to .env.local and fill in. Per-store Petpooja / PhonePe merchant / PineLabs secrets
# are stored in PostgreSQL (stores + store_*_credentials); see scripts/sample_data_ktr_bandra_versova.sql

POSTGRES_DB_URL=postgresql+asyncpg://USER:PASSWORD@localhost:5432/DBNAME
REDIS_HOST=redis://localhost:6379/0

# PhonePe API (shared across outlets; paths may differ sandbox vs prod)
PHONEPE_BASE_URL=https://mercury-uat.phonepe.com/enterprise-sandbox
PHONEPE_CALLBACK_URL=https://YOUR_PUBLIC_HOST/payments/webhook/phonepe
PHONEPE_QR_INIT_ENDPOINT=/v3/qr/init
PHONEPE_TRANSACTION_ENDPOINT=/v3/transaction

# Dashboard (KTR One) sign-in: signs session tokens. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Use the same value on every app instance; changing it signs everyone out.
ADMIN_JWT_SECRET=
# ADMIN_SESSION_HOURS=8

# APP_NAME=KTR KIOSK
# DEBUG_MODE=false
